    { "name": "−1.5", "source": "教材 p69 习题12(2) 的数值，手算", "params": { "format": "单精度", "direction": "十进制→机器数", "text": "-1.5" }, "expect": { "e": "0", "E": "127", "hex": "BFC00000H" } },
