{
 "note": "减去最小负数时按加法器（M=1）重算的那次加法：[x]补 + [y]补 各位取反 + 最低位进 1，n+1 位。adderCarry 是解题表「加法器进位」一行的 n+3 格（出界、S_f1、S_f2、各数值位），C_f 在 S_f1 格，C_0 在 S_f2 格，最右一格是最低位进的 1。由独立脚本算出，不是引擎的输出。只增不改。",
 "cases": [
  {
   "name": "−1 减最小负数，无溢出",
   "params": {
    "x": {
     "as": "真值",
     "text": "-0001"
    },
    "y": {
     "as": "真值",
     "text": "-10000"
    },
    "n": 4,
    "op": "减",
    "notation": "整数"
   },
   "expect": {
    "adderCarry": [
     "",
     "1",
     "1",
     "1",
     "1",
     "1",
     "1"
    ],
    "x": "11111",
    "notY": "01111",
    "sum": "01111",
    "cf": "1",
    "c0": "1",
    "overflow": "无溢出"
   }
  },
  {
   "name": "+1 减最小负数，正溢",
   "params": {
    "x": {
     "as": "真值",
     "text": "+0001"
    },
    "y": {
     "as": "真值",
     "text": "-10000"
    },
    "n": 4,
    "op": "减",
    "notation": "整数"
   },
   "expect": {
    "adderCarry": [
     "",
     "0",
     "1",
     "1",
     "1",
     "1",
     "1"
    ],
    "x": "00001",
    "notY": "01111",
    "sum": "10001",
    "cf": "0",
    "c0": "1",
    "overflow": "正溢"
   }
  },
  {
   "name": "0 减最小负数，正溢",
   "params": {
    "x": {
     "as": "真值",
     "text": "000"
    },
    "y": {
     "as": "真值",
     "text": "-1000"
    },
    "n": 3,
    "op": "减",
    "notation": "整数"
   },
   "expect": {
    "adderCarry": [
     "",
     "0",
     "1",
     "1",
     "1",
     "1"
    ],
    "x": "0000",
    "notY": "0111",
    "sum": "1000",
    "cf": "0",
    "c0": "1",
    "overflow": "正溢"
   }
  },
  {
   "name": "最小负数减最小负数，结果 0",
   "params": {
    "x": {
     "as": "真值",
     "text": "-10000"
    },
    "y": {
     "as": "真值",
     "text": "-10000"
    },
    "n": 4,
    "op": "减",
    "notation": "整数"
   },
   "expect": {
    "adderCarry": [
     "",
     "1",
     "1",
     "1",
     "1",
     "1",
     "1"
    ],
    "x": "10000",
    "notY": "01111",
    "sum": "00000",
    "cf": "1",
    "c0": "1",
    "overflow": "无溢出"
   }
  },
  {
   "name": "定点小数，−0.001 减 −1，无溢出",
   "params": {
    "x": {
     "as": "真值",
     "text": "-0.001"
    },
    "y": {
     "as": "真值",
     "text": "-1.000"
    },
    "n": 3,
    "op": "减",
    "notation": "小数"
   },
   "expect": {
    "adderCarry": [
     "",
     "1",
     "1",
     "1",
     "1",
     "1"
    ],
    "x": "1111",
    "notY": "0111",
    "sum": "0111",
    "cf": "1",
    "c0": "1",
    "overflow": "无溢出"
   }
  },
  {
   "name": "定点小数，+0.111 减 −1，正溢",
   "params": {
    "x": {
     "as": "真值",
     "text": "+0.111"
    },
    "y": {
     "as": "真值",
     "text": "-1.000"
    },
    "n": 3,
    "op": "减",
    "notation": "小数"
   },
   "expect": {
    "adderCarry": [
     "",
     "0",
     "1",
     "1",
     "1",
     "1"
    ],
    "x": "0111",
    "notY": "0111",
    "sum": "1111",
