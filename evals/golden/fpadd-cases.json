{
  "note": "浮点加减的固定用例。expect 是手算的，不是引擎的输出。aligned 是对阶后被移的那个尾数（括号里是移出的位），sum 是尾数相加的结果，shift、norm 是两道预测题的答案。负号用 U+2212。只增不改。",
  "cases": [
    { "name": "有效位格式，向左规格化 3 位", "source": "教材 p65–66 例2.30 的数值（解析 p17 计算17 同）",
      "params": { "style": "有效位", "digits": 4, "op": "加", "x": "0.5", "y": "-0.4375", "rounding": "0舍1入" },
      "expect": { "shift": "y 的尾数", "aligned": "−0.111(0)", "sum": "0.001(0)", "norm": "向左规格化", "result": "(1.000)₂ × 2^−4", "阶码": "−4", "尾数": "1.000", "overflow": "无溢出", "decimal": "0.0625" } },
    { "name": "补码格式加法，向左规格化 2 位", "source": "解析 p20 计算28 的数值（与教材 p69 习题9(2) 相同；解析印的符号有误）",
      "params": { "style": "补码", "k": 3, "m": 6, "op": "加", "x": { "exp": "-101", "mant": "-0.010110" }, "y": { "exp": "-100", "mant": "0.010110" }, "rounding": "0舍1入" },
      "expect": { "diffCode": "11111", "shift": "x 的尾数", "aligned": "11.110101(0)", "sum": "00.001011(0)", "norm": "向左规格化", "result": "2^−110 × 0.101100", "阶码": "11010", "尾数": "00.101100", "overflow": "无溢出", "decimal": "0.0107421875" } },
    { "name": "补码格式减法，已是规格化数", "source": "解析 p20 计算28 的数值（与教材 p69 习题9(2) 相同）",
      "params": { "style": "补码", "k": 3, "m": 6, "op": "减", "x": { "exp": "-101", "mant": "-0.010110" }, "y": { "exp": "-100", "mant": "0.010110" }, "rounding": "0舍1入" },
      "expect": { "shift": "x 的尾数", "aligned": "11.110101(0)", "sum": "11.011111(0)", "norm": "不用规格化", "result": "2^−100 × (−0.100001)", "阶码": "11100", "尾数": "11.011111", "overflow": "无溢出", "decimal": "−0.0322265625" } },
    { "name": "补码格式加法，负数向左规格化", "source": "教材 p69 习题9(1) 的数值，手算",
      "params": { "style": "补码", "k": 3, "m": 6, "op": "加", "x": { "exp": "-011", "mant": "0.100101" }, "y": { "exp": "-010", "mant": "-0.011110" }, "rounding": "0舍1入" },
      "expect": { "shift": "x 的尾数", "aligned": "00.010010(1)", "sum": "11.110100(1)", "norm": "向左规格化", "result": "2^−100 × (−0.101110)", "阶码": "11100", "尾数": "11.010010", "overflow": "无溢出", "decimal": "−0.044921875" } },
    { "name": "补码格式减法，0 舍 1 入进 1", "source": "教材 p69 习题9(1) 的数值，手算",
      "params": { "style": "补码", "k": 3, "m": 6, "op": "减", "x": { "exp": "-011", "mant": "0.100101" }, "y": { "exp": "-010", "mant": "-0.011110" }, "rounding": "0舍1入" },
      "expect": { "shift": "x 的尾数", "aligned": "00.010010(1)", "sum": "00.110000(1)", "norm": "不用规格化", "result": "2^−010 × 0.110001", "阶码": "11110", "尾数": "00.110001", "overflow": "无溢出", "decimal": "0.19140625" } },
    { "name": "补码格式减法，截断", "source": "教材 p69 习题9(1) 的数值，手算",
      "params": { "style": "补码", "k": 3, "m": 6, "op": "减", "x": { "exp": "-011", "mant": "0.100101" }, "y": { "exp": "-010", "mant": "-0.011110" }, "rounding": "截断" },
      "expect": { "result": "2^−010 × 0.110000", "阶码": "11110", "尾数": "00.110000", "overflow": "无溢出", "decimal": "0.1875" } },
    { "name": "x 为 0，减法得 −y", "source": "自拟，按图2.17",
      "params": { "style": "补码", "k": 3, "m": 6, "op": "减", "x": { "exp": "000", "mant": "0.000000" }, "y": { "exp": "010", "mant": "-0.110000" }, "rounding": "0舍1入" },
      "expect": { "result": "2^010 × 0.110000", "阶码": "00010", "尾数": "00.110000", "overflow": "无溢出", "decimal": "3" } },
    { "name": "两个最大正数相加，上溢", "source": "自拟",
      "params": { "style": "补码", "k": 3, "m": 6, "op": "加", "x": { "exp": "111", "mant": "0.111111" }, "y": { "exp": "111", "mant": "0.111111" }, "rounding": "0舍1入" },
      "expect": { "shift": "都不移", "sum": "01.111110", "norm": "向右规格化", "result": "上溢", "阶码": "01000", "overflow": "上溢", "decimal": "无" } },
    { "name": "舍入进位后再向右规格化", "source": "自拟",
      "params": { "style": "补码", "k": 3, "m": 6, "op": "加", "x": { "exp": "000", "mant": "0.111110" }, "y": { "exp": "-001", "mant": "0.000011" }, "rounding": "0舍1入" },
      "expect": { "shift": "y 的尾数", "aligned": "00.000001(1)", "sum": "00.111111(1)", "norm": "不用规格化", "result": "2^001 × 0.100000", "阶码": "00001", "尾数": "00.100000", "overflow": "无溢出", "decimal": "1" } },
    { "name": "舍入后成 11.100000，再向左规格化", "source": "自拟",
      "params": { "style": "补码", "k": 3, "m": 6, "op": "加", "x": { "exp": "000", "mant": "-0.110000" }, "y": { "exp": "-001", "mant": "0.011111" }, "rounding": "0舍1入" },
      "expect": { "shift": "y 的尾数", "aligned": "00.001111(1)", "sum": "11.011111(1)", "norm": "不用规格化", "result": "2^−001 × (−1.000000)", "阶码": "11111", "尾数": "11.000000", "overflow": "无溢出", "decimal": "−0.5" } },
    { "name": "有效位格式，舍入进位再右移", "source": "自拟",
      "params": { "style": "有效位", "digits": 4, "op": "加", "x": "1.75", "y": "0.234375", "rounding": "0舍1入" },
      "expect": { "shift": "y 的尾数", "aligned": "0.001(111)", "sum": "1.111(111)", "norm": "不用规格化", "result": "(1.000)₂ × 2^1", "阶码": "1", "尾数": "1.000", "overflow": "无溢出", "decimal": "2" } },
    { "name": "有效位格式，截断", "source": "自拟",
      "params": { "style": "有效位", "digits": 4, "op": "加", "x": "1.75", "y": "0.234375", "rounding": "截断" },
      "expect": { "result": "(1.111)₂ × 2^0", "阶码": "0", "尾数": "1.111", "overflow": "无溢出", "decimal": "1.875" } },
    { "name": "有效位格式，减法向右规格化", "source": "自拟",
      "params": { "style": "有效位", "digits": 4, "op": "减", "x": "1.5", "y": "-0.875", "rounding": "0舍1入" },
      "expect": { "shift": "y 的尾数", "aligned": "0.111(0)", "sum": "10.011(0)", "norm": "向右规格化", "result": "(1.010)₂ × 2^1", "阶码": "1", "尾数": "1.010", "overflow": "无溢出", "decimal": "2.5" } }
  ]
}
