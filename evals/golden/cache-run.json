{
  "note": "cache 逐次访问的固定用例，全部手算，数是本站自己出的。table 的列是 访问 | 块号 | 行号或组号（全相联为所在行）| 标记 | 结果 | 换出。finalRows 是最后各行的 [标记, 块号, 修改位, 计数器]，空行的标记和块号为 null。hitAsks 是出「这次访问命中吗」的访问序号（从 1 起）；victimAsks 是出「换出哪一行」的访问序号和答案。只增不改。",
  "cases": [
    {
      "name": "直接映射：块 3 和块 11 抢行 3，第 4 次访问的块 3 之前装入过，仍然缺失",
      "params": {
        "mapping": "直接",
        "rows": 4,
        "blockWords": 2,
        "addressBits": 5,
        "unit": "字",
        "accesses": [
          { "address": 6, "op": "读" },
          { "address": 7, "op": "读" },
          { "address": 22, "op": "读" },
          { "address": 6, "op": "读" },
          { "address": 12, "op": "读" },
          { "address": 23, "op": "读" },
          { "address": 14, "op": "读" }
        ]
      },
      "expect": {
        "table": [
          ["6", "3", "3", "0", "缺失", ""],
          ["7", "3", "3", "0", "命中", ""],
          ["22", "11", "3", "2", "缺失", "块 3"],
          ["6", "3", "3", "0", "缺失", "块 11"],
          ["12", "6", "2", "1", "缺失", ""],
          ["23", "11", "3", "2", "缺失", "块 3"],
          ["14", "7", "3", "1", "缺失", "块 11"]
        ],
        "finalRows": [
          [null, null, 0, 0],
          [null, null, 0, 0],
          [1, 6, 0, 0],
          [1, 7, 0, 0]
        ],
        "result": { "命中次数": "1", "缺失次数": "6", "h": "1/7 ≈ 0.1429" },
        "hitAsks": [3, 4, 6, 7],
        "victimAsks": []
      }
    },
    {
      "name": "同一串地址改成 2 路组相联加 LRU：块 3 和块 11 同在第 1 组，第 4 次访问命中",
      "params": {
        "mapping": "组相联",
        "rows": 4,
        "rowsPerSet": 2,
        "blockWords": 2,
        "addressBits": 5,
        "unit": "字",
        "replacement": "LRU",
        "accesses": [
          { "address": 6, "op": "读" },
          { "address": 7, "op": "读" },
          { "address": 22, "op": "读" },
          { "address": 6, "op": "读" },
          { "address": 12, "op": "读" },
          { "address": 23, "op": "读" },
          { "address": 14, "op": "读" }
        ]
      },
      "expect": {
        "table": [
          ["6", "3", "1", "1", "缺失", ""],
          ["7", "3", "1", "1", "命中", ""],
          ["22", "11", "1", "5", "缺失", ""],
          ["6", "3", "1", "1", "命中", ""],
          ["12", "6", "0", "3", "缺失", ""],
          ["23", "11", "1", "5", "命中", ""],
          ["14", "7", "1", "3", "缺失", "块 3"]
        ],
        "finalRows": [
          [3, 6, 0, 0],
          [null, null, 0, 0],
          [3, 7, 0, 0],
          [5, 11, 0, 1]
        ],
        "result": { "命中次数": "3", "缺失次数": "4", "h": "3/7 ≈ 0.4286" },
        "hitAsks": [4, 6, 7],
        "victimAsks": [{ "access": 7, "answer": "行 2" }]
      }
    },
    {
      "name": "全相联 2 行加 LFU，带写操作和访问时间：替换时计数器清零，并列取行号小的",
      "params": {
        "mapping": "全相联",
        "rows": 2,
        "blockWords": 4,
        "addressBits": 6,
        "unit": "字",
        "replacement": "LFU",
        "tc": 10,
        "tm": 100,
        "accesses": [
          { "address": 0, "op": "读" },
          { "address": 5, "op": "写" },
          { "address": 2, "op": "读" },
          { "address": 1, "op": "读" },
          { "address": 9, "op": "读" },
          { "address": 10, "op": "读" },
          { "address": 6, "op": "读" },
          { "address": 3, "op": "写" }
        ]
      },
      "expect": {
        "table": [
          ["0", "0", "0", "0", "缺失", ""],
          ["5（写）", "1", "1", "1", "缺失", ""],
          ["2", "0", "0", "0", "命中", ""],
          ["1", "0", "0", "0", "命中", ""],
          ["9", "2", "1", "2", "缺失", "块 1（写回）"],
          ["10", "2", "1", "2", "命中", ""],
          ["6", "1", "0", "1", "缺失", "块 0"],
          ["3（写）", "0", "0", "0", "缺失", "块 1"]
        ],
        "finalRows": [
          [0, 0, 1, 0],
          [2, 2, 0, 0]
        ],
        "result": {
          "命中次数": "3",
          "缺失次数": "5",
          "h": "3/8 = 0.375",
          "r": "10",
          "t_a": "66.25 ns",
          "e": "15.09%"
        },
        "hitAsks": [3, 5, 7, 8],
        "victimAsks": [
          { "access": 5, "answer": "行 1" },
          { "access": 7, "answer": "行 0" }
        ]
      }
    }
  ]
}
