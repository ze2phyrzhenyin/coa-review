{
  "note": "原码、反码、补码、移码的固定用例。expect 是手算的（按式 2.5–2.9 和 p27 的两步规则），不是引擎的输出。机器码不带小数点和逗号；zero 是 0 的另一种写法；null 表示这种码写不出来。只增不改。",
  "cases": [
    { "name": "正数三种码相同", "source": "教材 p27 例2.3 的数值", "params": { "n": 7, "notation": "整数", "input": { "as": "十进制", "text": "+122" } },
      "expect": { "binary": "+1111010", "decimal": "122", "原码": { "bits": "01111010" }, "反码": { "bits": "01111010" }, "补码": { "bits": "01111010" }, "移码": { "bits": "11111010" } } },
    { "name": "负数取反加一", "source": "教材 p27 例2.4 的数值", "params": { "n": 7, "notation": "整数", "input": { "as": "十进制", "text": "-122" } },
      "expect": { "binary": "−1111010", "decimal": "−122", "原码": { "bits": "11111010" }, "反码": { "bits": "10000101" }, "补码": { "bits": "10000110" }, "移码": { "bits": "00000110" } } },
    { "name": "9 位补码求真值，正数", "source": "教材 p26 例2.1 的数值", "params": { "n": 8, "notation": "整数", "input": { "as": "机器数", "code": "补码", "bits": "010011011" } },
      "expect": { "binary": "+10011011", "decimal": "155", "原码": { "bits": "010011011" }, "反码": { "bits": "010011011" }, "补码": { "bits": "010011011" }, "移码": { "bits": "110011011" } } },
    { "name": "9 位补码求真值，负数", "source": "教材 p26 例2.2 的数值", "params": { "n": 8, "notation": "整数", "input": { "as": "机器数", "code": "补码", "bits": "110011011" } },
      "expect": { "binary": "−01100101", "decimal": "−101", "原码": { "bits": "101100101" }, "反码": { "bits": "110011010" }, "补码": { "bits": "110011011" }, "移码": { "bits": "010011011" } } },
    { "name": "−127", "source": "教材 p30 例2.8 表", "params": { "n": 7, "notation": "整数", "input": { "as": "十进制", "text": "-127" } },
      "expect": { "binary": "−1111111", "decimal": "−127", "原码": { "bits": "11111111" }, "反码": { "bits": "10000000" }, "补码": { "bits": "10000001" }, "移码": { "bits": "00000001" } } },
    { "name": "−1", "source": "教材 p30 例2.8 表", "params": { "n": 7, "notation": "整数", "input": { "as": "十进制", "text": "-1" } },
      "expect": { "binary": "−0000001", "decimal": "−1", "原码": { "bits": "10000001" }, "反码": { "bits": "11111110" }, "补码": { "bits": "11111111" }, "移码": { "bits": "01111111" } } },
    { "name": "0 的两种写法", "source": "教材 p30 例2.8 表", "params": { "n": 7, "notation": "整数", "input": { "as": "十进制", "text": "0" } },
      "expect": { "binary": "0000000", "decimal": "0", "原码": { "bits": "00000000", "zero": "10000000" }, "反码": { "bits": "00000000", "zero": "11111111" }, "补码": { "bits": "00000000" }, "移码": { "bits": "10000000" } } },
    { "name": "+1", "source": "教材 p30 例2.8 表", "params": { "n": 7, "notation": "整数", "input": { "as": "十进制", "text": "1" } },
      "expect": { "binary": "+0000001", "decimal": "1", "原码": { "bits": "00000001" }, "反码": { "bits": "00000001" }, "补码": { "bits": "00000001" }, "移码": { "bits": "10000001" } } },
    { "name": "+127", "source": "教材 p30 例2.8 表", "params": { "n": 7, "notation": "整数", "input": { "as": "十进制", "text": "127" } },
      "expect": { "binary": "+1111111", "decimal": "127", "原码": { "bits": "01111111" }, "反码": { "bits": "01111111" }, "补码": { "bits": "01111111" }, "移码": { "bits": "11111111" } } },
    { "name": "移码，正阶码", "source": "教材 p27 移码的数值", "params": { "n": 5, "notation": "整数", "input": { "as": "真值", "text": "+10101" } },
      "expect": { "binary": "+10101", "decimal": "21", "原码": { "bits": "010101" }, "反码": { "bits": "010101" }, "补码": { "bits": "010101" }, "移码": { "bits": "110101" } } },
    { "name": "移码，负阶码", "source": "教材 p27 移码的数值", "params": { "n": 5, "notation": "整数", "input": { "as": "真值", "text": "-10101" } },
      "expect": { "binary": "−10101", "decimal": "−21", "原码": { "bits": "110101" }, "反码": { "bits": "101010" }, "补码": { "bits": "101011" }, "移码": { "bits": "001011" } } },
    { "name": "习题 1(1)", "source": "教材 p68 习题1 的数值，手算", "params": { "n": 7, "notation": "整数", "input": { "as": "十进制", "text": "-35" } },
      "expect": { "binary": "−0100011", "decimal": "−35", "原码": { "bits": "10100011" }, "反码": { "bits": "11011100" }, "补码": { "bits": "11011101" }, "移码": { "bits": "01011101" } } },
    { "name": "−128 只有补码和移码", "source": "教材 p68 习题1 的数值，手算", "params": { "n": 7, "notation": "整数", "input": { "as": "十进制", "text": "-128" } },
      "expect": { "binary": "−10000000", "decimal": "−128", "原码": null, "反码": null, "补码": { "bits": "10000000" }, "移码": { "bits": "00000000" } } },
    { "name": "定点小数负数", "source": "自拟", "params": { "n": 4, "notation": "小数", "input": { "as": "真值", "text": "-0.0111" } },
      "expect": { "binary": "−0.0111", "decimal": "−0.4375", "原码": { "bits": "10111" }, "反码": { "bits": "11000" }, "补码": { "bits": "11001" }, "移码": { "bits": "01001" } } },
    { "name": "定点小数 −1", "source": "自拟", "params": { "n": 4, "notation": "小数", "input": { "as": "十进制", "text": "-1" } },
      "expect": { "binary": "−1.0000", "decimal": "−1", "原码": null, "反码": null, "补码": { "bits": "10000" }, "移码": { "bits": "00000" } } },
    { "name": "定点小数十进制输入", "source": "自拟", "params": { "n": 4, "notation": "小数", "input": { "as": "十进制", "text": "0.375" } },
      "expect": { "binary": "+0.0110", "decimal": "0.375", "原码": { "bits": "00110" }, "反码": { "bits": "00110" }, "补码": { "bits": "00110" }, "移码": { "bits": "10110" } } },
    { "name": "原码负零读回 0", "source": "自拟", "params": { "n": 4, "notation": "整数", "input": { "as": "机器数", "code": "原码", "bits": "10000" } },
      "expect": { "binary": "0000", "decimal": "0", "原码": { "bits": "00000", "zero": "10000" }, "反码": { "bits": "00000", "zero": "11111" }, "补码": { "bits": "00000" }, "移码": { "bits": "10000" } } },
    { "name": "由移码读回真值", "source": "自拟", "params": { "n": 7, "notation": "整数", "input": { "as": "机器数", "code": "移码", "bits": "0,1011101" } },
      "expect": { "binary": "−0100011", "decimal": "−35", "原码": { "bits": "10100011" }, "反码": { "bits": "11011100" }, "补码": { "bits": "11011101" }, "移码": { "bits": "01011101" } } }
  ]
}
