{
  "note": "串行帧与总线带宽的固定用例。expect 由手算得出，不是引擎的输出。帧是发送次序的位串（起始位在左）。例 6.1、例 6.2、习题 10 只取数值，字符和编码是本站选的。非整数写 4 位有效数字带「≈」。只增不改。",
  "cases": [
    {
      "name": "例 6.2 的数值：120 字符/秒，8 位数据无校验 1 位停止，每帧 10 位",
      "source": "教材 p211 例 6.2 的数值；字符 K（0x4B）自选",
      "params": { "task": "串行帧", "code": 75, "char": "K", "dataBits": 8, "parity": "无", "stopBits": 1, "charRate": 120 },
      "expect": { "帧": "0110100101", "每帧位数": "10", "波特率": "1200 波特", "字符速率": "120 字符/秒", "每位时间": "≈ 0.8333 ms", "有效数据率": "960 位/秒" }
    },
    {
      "name": "习题 10 的格式：7 位数据 + 偶校验 + 1 位起始 + 1 位停止，9600 波特",
      "source": "教材 p229 习题 10 的数值；字符 A（0x41）自选。0x41 有两个 1，偶校验补 0",
      "params": { "task": "串行帧", "code": 65, "char": "A", "dataBits": 7, "parity": "偶", "stopBits": 1, "baud": 9600 },
      "expect": { "帧": "0100000101", "每帧位数": "10", "波特率": "9600 波特", "字符速率": "960 字符/秒", "每位时间": "≈ 0.1042 ms", "有效数据率": "6720 位/秒" }
    },
    {
      "name": "手算：S（0x53）7 位奇校验 2 位停止，150 字符/秒",
      "source": "自拟。1010011 低位先发是 1100101；4 个 1，奇校验补 1；1+7+1+2 = 11 位；150×11 = 1650；1/1650 s ≈ 0.60606 ms；150×7 = 1050",
      "params": { "task": "串行帧", "code": 83, "char": "S", "dataBits": 7, "parity": "奇", "stopBits": 2, "charRate": 150 },
      "expect": { "帧": "01100101111", "每帧位数": "11", "波特率": "1650 波特", "字符速率": "150 字符/秒", "每位时间": "≈ 0.6061 ms", "有效数据率": "1050 位/秒" }
    },
    {
      "name": "手算：只要波形，不给速率；5 位数据 0x16 偶校验",
      "source": "自拟。10110 低位先发是 01101；3 个 1，偶校验补 1",
      "params": { "task": "串行帧", "code": 22, "dataBits": 5, "parity": "偶", "stopBits": 1 },
      "expect": { "帧": "00110111", "每帧位数": "8" }
    },
    {
      "name": "例 6.1(1) 的数值：32 位，33 MHz，一个总线周期一个时钟",
      "source": "教材 p205 例 6.1",
      "params": { "task": "总线带宽", "widthBits": 32, "freqMHz": 33, "clocksPerCycle": 1 },
      "expect": { "带宽": "132 MB/s" }
    },
    {
      "name": "例 6.1(2) 的数值：64 位，66 MHz",
      "source": "教材 p205 例 6.1",
      "params": { "task": "总线带宽", "widthBits": 64, "freqMHz": 66, "clocksPerCycle": 1 },
      "expect": { "带宽": "528 MB/s" }
    },
    {
      "name": "手算：64 位，50 MHz，每个总线周期 2 个时钟",
      "source": "自拟。8 B × 50×10^6 ÷ 2 = 200×10^6 B/s",
      "params": { "task": "总线带宽", "widthBits": 64, "freqMHz": 50, "clocksPerCycle": 2 },
      "expect": { "带宽": "200 MB/s" }
    }
  ]
}
