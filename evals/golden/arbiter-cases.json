{
  "note": "集中式总线仲裁的固定用例，全部手算，数是本站自己出的。时间以总线周期计。table 的列是 次序 | 时刻 | 提出请求的设备 | 查询经过 | 获得总线 | 占用。前三例用同一组请求：设备 3、1 在 0 时刻，设备 2 在 1 时刻，设备 0 在 3 时刻。只增不改。",
  "cases": [
    {
      "name": "链式查询：离仲裁器近的先得，设备 3 一直等到最后",
      "params": { "mode": "链式查询", "devices": 4, "requests": [ { "device": 3, "at": 0, "hold": 2 }, { "device": 1, "at": 0, "hold": 2 }, { "device": 2, "at": 1, "hold": 1 }, { "device": 0, "at": 3, "hold": 1 } ] },
      "expect": {
        "table": [ ["1", "0", "1、3", "0→1", "设备 1", "0–2"], ["2", "2", "2、3", "0→1→2", "设备 2", "2–3"], ["3", "3", "0、3", "0", "设备 0", "3–4"], ["4", "4", "3", "0→1→2→3", "设备 3", "4–6"] ],
        "result": { "授权次序": "设备 1，设备 2，设备 0，设备 3", "结束时刻": "6", "等待合计": "5" },
        "never": []
      }
    },
    {
      "name": "计数器从中止点：停在 2 以后从 3 计，设备 3 比链式早得到",
      "params": { "mode": "计数器定时查询", "counterFrom": "中止点", "devices": 4, "requests": [ { "device": 3, "at": 0, "hold": 2 }, { "device": 1, "at": 0, "hold": 2 }, { "device": 2, "at": 1, "hold": 1 }, { "device": 0, "at": 3, "hold": 1 } ] },
      "expect": {
        "table": [ ["1", "0", "1、3", "计数 0→1", "设备 1", "0–2"], ["2", "2", "2、3", "计数 2", "设备 2", "2–3"], ["3", "3", "0、3", "计数 3", "设备 3", "3–5"], ["4", "5", "0", "计数 0", "设备 0", "5–6"] ],
        "result": { "授权次序": "设备 1，设备 2，设备 3，设备 0", "结束时刻": "6", "等待合计": "6" },
        "never": []
      }
    },
    {
      "name": "计数器从 0：与链式查询的次序相同",
      "params": { "mode": "计数器定时查询", "counterFrom": "0", "devices": 4, "requests": [ { "device": 3, "at": 0, "hold": 2 }, { "device": 1, "at": 0, "hold": 2 }, { "device": 2, "at": 1, "hold": 1 }, { "device": 0, "at": 3, "hold": 1 } ] },
      "expect": {
        "table": [ ["1", "0", "1、3", "计数 0→1", "设备 1", "0–2"], ["2", "2", "2、3", "计数 0→1→2", "设备 2", "2–3"], ["3", "3", "0、3", "计数 0", "设备 0", "3–4"], ["4", "4", "3", "计数 0→1→2→3", "设备 3", "4–6"] ],
        "result": { "授权次序": "设备 1，设备 2，设备 0，设备 3", "结束时刻": "6", "等待合计": "5" },
        "never": []
      }
    },
    {
      "name": "独立请求：优先次序倒过来，屏蔽设备 2",
      "params": { "mode": "独立请求", "priority": [3, 2, 1, 0], "masked": [2], "devices": 4, "requests": [ { "device": 3, "at": 0, "hold": 2 }, { "device": 1, "at": 0, "hold": 2 }, { "device": 2, "at": 1, "hold": 1 }, { "device": 0, "at": 3, "hold": 1 } ] },
      "expect": {
        "table": [ ["1", "0", "1、3", "排队电路", "设备 3", "0–2"], ["2", "2", "1、2", "排队电路", "设备 1", "2–4"], ["3", "4", "0、2", "排队电路", "设备 0", "4–5"] ],
        "result": { "授权次序": "设备 3，设备 1，设备 0", "结束时刻": "5", "等待合计": "3", "得不到总线": "设备 2" },
        "never": [2]
      }
    },
    {
      "name": "弄坏它：接口 1 的链断了，设备 2 每次 BG 都到不了",
      "params": { "mode": "链式查询", "broken": 1, "devices": 4, "requests": [ { "device": 2, "at": 0, "hold": 1 }, { "device": 0, "at": 2, "hold": 2 }, { "device": 1, "at": 5, "hold": 1 } ] },
      "expect": {
        "table": [ ["1", "0", "2", "0→1", "无", "—"], ["2", "2", "0、2", "0", "设备 0", "2–4"], ["3", "4", "2", "0→1", "无", "—"], ["4", "5", "1、2", "0→1", "设备 1", "5–6"], ["5", "6", "2", "0→1", "无", "—"] ],
        "result": { "授权次序": "设备 0，设备 1", "结束时刻": "6", "等待合计": "0", "得不到总线": "设备 2" },
        "never": [0]
      }
    }
  ]
}
