{
  "note": "多级中断屏蔽字与运行轨迹的固定用例。教材没有这类例题，屏蔽字和轨迹都是按 p270 的规则手算的，不是教材给的答案。屏蔽字左起依次是 L0…L(n−1)，1 = 屏蔽。segments 是 [谁, 起, 止, 嵌套深度]，主程序为 -1、深度 0；同一次进入的连续运行合成一段，零长度不记。只增不改。",
  "cases": [
    {
      "name": "习题 8 的条件：5 级同时请求，处理次序改为 L1→L3→L0→L4→L2，每级运行 2",
      "source": "教材 p290 习题 8 的条件；运行时间自拟。先进 L0，它放过 L1、L3；L1 打断 L0 做完，L3 再打断 L0 做完，L0 做完回主程序；剩 L2、L4，先进 L2，它放过 L4，L4 打断 L2",
      "params": { "levels": 5, "order": [1, 3, 0, 4, 2], "arrivals": [ { "level": 0, "at": 0 }, { "level": 1, "at": 0 }, { "level": 2, "at": 0 }, { "level": 3, "at": 0 }, { "level": 4, "at": 0 } ], "service": 2 },
      "expect": {
        "masks": ["10101", "11111", "00100", "10111", "00101"],
        "segments": [[1, 0, 2, 2], [3, 2, 4, 2], [0, 4, 6, 1], [4, 6, 8, 2], [2, 8, 10, 1]],
        "result": { "屏蔽字": "10101 / 11111 / 00100 / 10111 / 00101", "处理次序": "L1→L3→L0→L4→L2", "完成次序": "L1、L3、L0、L4、L2", "运行轨迹": "L1 0–2，L3 2–4，L0 4–6，L4 6–8，L2 8–10", "结束时刻": "10" }
      }
    },
    {
      "name": "处理次序等于响应次序：请求一个比一个高，层层嵌套；L2 第二次请求被自己挡住，做完回主程序后才进",
      "source": "自拟。L2 在 0 进，L1 在 1 打断，L0 在 2 打断并做到 4；L2 在 4 又请求，被 L1 的 011 挡住；L1 做到 6，L2 接着做 3 到 9，回主程序后再进 L2 做到 13",
      "params": { "levels": 3, "arrivals": [ { "level": 2, "at": 0 }, { "level": 1, "at": 1 }, { "level": 0, "at": 2 }, { "level": 2, "at": 4 } ], "service": [2, 3, 4] },
      "expect": {
        "masks": ["111", "011", "001"],
        "segments": [[2, 0, 1, 1], [1, 1, 2, 2], [0, 2, 4, 3], [1, 4, 6, 2], [2, 6, 9, 1], [2, 9, 13, 1]],
        "result": { "屏蔽字": "111 / 011 / 001", "处理次序": "L0→L1→L2", "完成次序": "L0、L1、L2、L2", "运行轨迹": "L2 0–1，L1 1–2，L0 2–4，L1 4–6，L2 6–9，L2 9–13", "结束时刻": "13" }
      }
    },
    {
      "name": "反推：给屏蔽字 1101 / 0100 / 1111 / 0101，1 的个数 3、1、4、2，处理次序 L2→L0→L3→L1",
      "source": "自拟。L1 在 0 进（它只挡自己），L3 在 1 打断，L0 在 2 打断并做完，再依次回 L3、L1",
      "params": { "levels": 4, "masks": ["1101", "0100", "1111", "0101"], "arrivals": [ { "level": 1, "at": 0 }, { "level": 3, "at": 1 }, { "level": 0, "at": 2 } ], "service": 2 },
      "expect": {
        "masks": ["1101", "0100", "1111", "0101"],
        "segments": [[1, 0, 1, 1], [3, 1, 2, 2], [0, 2, 4, 3], [3, 4, 5, 2], [1, 5, 6, 1]],
        "result": { "屏蔽字": "1101 / 0100 / 1111 / 0101", "处理次序": "L2→L0→L3→L1", "完成次序": "L0、L3、L1", "运行轨迹": "L1 0–1，L3 1–2，L0 2–4，L3 4–5，L1 5–6", "结束时刻": "6" }
      }
    },
    {
      "name": "弄坏它：L1 的屏蔽字把自己置 0，第二个 L1 请求打断正在处理的 L1",
      "source": "自拟。屏蔽字 11 / 00 排不成处理次序（按 1 的个数排出 L0→L1 再推是 11 / 01）",
      "params": { "levels": 2, "masks": ["11", "00"], "arrivals": [ { "level": 1, "at": 0 }, { "level": 1, "at": 1 } ], "service": 2 },
      "expect": {
        "masks": ["11", "00"],
        "segments": [[1, 0, 1, 1], [1, 1, 3, 2], [1, 3, 4, 1]],
        "result": { "屏蔽字": "11 / 00", "处理次序": "不能排成一个处理次序", "完成次序": "L1、L1", "运行轨迹": "L1 0–1，L1 1–3，L1 3–4", "结束时刻": "4" }
      }
    }
  ]
}
