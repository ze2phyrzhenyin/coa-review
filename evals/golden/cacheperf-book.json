{
  "note": "cache 命中率、平均访问时间、访问效率的固定用例。教材例题只取数值；习题 9、10 的答案是按教材公式手算的（解析书不作标准）。result 是引擎显示的字符串，values 是数值（容差 1e-6）。只增不改。",
  "cases": [
    {
      "name": "例 3.4，按书上的顺序 h → r → e → t_a",
      "source": "教材 p101–102 例 3.4",
      "params": { "kind": "正向", "nc": 1900, "nm": 100, "tc": 50, "tm": 250 },
      "expect": {
        "order": ["h", "r", "e", "t_a"],
        "result": { "h": "0.95", "r": "5", "e": "83.3%", "t_a": "60 ns" },
        "values": { "h": 0.95, "r": 5, "e": 0.8333333333, "t_a": 60 }
      }
    },
    {
      "name": "例 3.4 的数，先用式(3.5) 求 t_a",
      "source": "教材 p101 式(3.5)；解析书 p41 的顺序",
      "params": { "kind": "正向", "nc": 1900, "nm": 100, "tc": 50, "tm": 250, "order": "先求ta" },
      "expect": {
        "order": ["h", "t_a", "e", "r"],
        "result": { "h": "0.95", "r": "5", "e": "83.3%", "t_a": "60 ns" },
        "values": { "h": 0.95, "r": 5, "e": 0.8333333333, "t_a": 60 }
      }
    },
    {
      "name": "习题 9：2420 次与 80 次，40 ns 与 240 ns",
      "source": "教材 p122 习题 9（手算）",
      "params": { "kind": "正向", "nc": 2420, "nm": 80, "tc": 40, "tm": 240 },
      "expect": {
        "order": ["h", "r", "e", "t_a"],
        "result": { "h": "0.968", "r": "6", "e": "86.2%", "t_a": "46.4 ns" },
        "values": { "h": 0.968, "r": 6, "e": 0.8620689655, "t_a": 46.4 }
      }
    },
    {
      "name": "习题 10：由 t_a = 50 ns 反求 h",
      "source": "教材 p123 习题 10（手算）",
      "params": { "kind": "由ta求h", "tc": 40, "tm": 200, "ta": 50 },
      "expect": {
        "order": ["h", "r", "e"],
        "result": { "h": "0.9375", "r": "5", "e": "80%" },
        "values": { "h": 0.9375, "r": 5, "e": 0.8 }
      }
    },
    {
      "name": "本站自拟：4750 次与 250 次，20 ns 与 120 ns",
      "source": "docs/textbook/ch03.md 自拟小例",
      "params": { "kind": "正向", "nc": 4750, "nm": 250, "tc": 20, "tm": 120 },
      "expect": {
        "order": ["h", "r", "e", "t_a"],
        "result": { "h": "0.95", "r": "6", "e": "80%", "t_a": "25 ns" },
        "values": { "h": 0.95, "r": 6, "e": 0.8, "t_a": 25 }
      }
    },
    {
      "name": "本站自拟：由 e = 80%、r = 6 反求 h",
      "source": "自拟，与上一例互逆",
      "params": { "kind": "由e求h", "e": 0.8, "r": 6 },
      "expect": { "order": ["h"], "result": { "h": "0.95" }, "values": { "h": 0.95 } }
    },
    {
      "name": "本站自拟：由 e = 80% 和 20 ns、120 ns 反求 h，再求 t_a",
      "source": "自拟",
      "params": { "kind": "由e求h", "e": 0.8, "tc": 20, "tm": 120 },
      "expect": {
        "order": ["r", "h", "t_a"],
        "result": { "r": "6", "h": "0.95", "t_a": "25 ns" },
        "values": { "r": 6, "h": 0.95, "t_a": 25 }
      }
    },
    {
      "name": "例 3.8：加二级 cache 后 CPI 从 11 降到 4",
      "source": "教材 p110 例 3.8（书上把 2.75 写作约 2.8）",
      "params": { "kind": "二级cache", "clockGHz": 5, "baseCpi": 1, "memoryNs": 100, "l1Miss": 0.02, "l2Ns": 5, "l2Miss": 0.005 },
      "expect": {
        "order": ["时钟周期", "主存缺失损失", "一级CPI", "二级缺失损失", "两级CPI", "性能比"],
        "result": { "时钟周期": "0.2 ns", "主存缺失损失": "500 个周期", "一级CPI": "11", "二级缺失损失": "25 个周期", "两级CPI": "4", "性能比": "2.75" },
        "values": { "时钟周期": 0.2, "主存缺失损失": 500, "一级CPI": 11, "二级缺失损失": 25, "两级CPI": 4, "性能比": 2.75 }
      }
    }
  ]
}
