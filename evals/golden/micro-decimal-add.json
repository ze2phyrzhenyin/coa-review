{
  "note": "图 5.25 十进制加法微程序（教材 p170–172）。控存四条微指令的编码照图 5.25 与 p171–172 正文；P2 的约定照 p172：Cy=0 时下一条是 0001，Cy=1 时是 0000。a、b 是本站自取的数，教材没有给具体数值。寄存器 4 位；只有 + 改 Cy（docs/DECISIONS.md）。",
  "store": [
    { "addr": "0000", "word": "00000000000000101100000", "commands": ["LDIR′", "PC+1"] },
    { "addr": "1010", "word": "01010010010000000001001", "commands": ["LDR2′", "R1→X", "R2→Y", "+"] },
    { "addr": "1001", "word": "01000100110000000010000", "commands": ["LDR2′", "R2→X", "R3→Y", "+"] },
    { "addr": "0001", "word": "01001100000100000000000", "commands": ["LDR2′", "R1→Y", "R2→X", "−"] }
  ],
  "cases": [
    { "name": "3+4：Cy=0，走第四条减 6", "params": { "a": 3, "b": 4 }, "expect": { "path": ["0000", "1010", "1001", "0001"], "R2": 7, "Cy": 0, "afterEach": [null, 9, 13, 7] } },
    { "name": "8+5：Cy=1，第三条后直接回取指", "params": { "a": 8, "b": 5 }, "expect": { "path": ["0000", "1010", "1001"], "R2": 3, "Cy": 1, "afterEach": [null, 14, 3] } },
    { "name": "9+9：最大的和", "params": { "a": 9, "b": 9 }, "expect": { "path": ["0000", "1010", "1001"], "R2": 8, "Cy": 1, "afterEach": [null, 15, 8] } },
    { "name": "0+0", "params": { "a": 0, "b": 0 }, "expect": { "path": ["0000", "1010", "1001", "0001"], "R2": 0, "Cy": 0, "afterEach": [null, 6, 6, 0] } }
  ]
}
